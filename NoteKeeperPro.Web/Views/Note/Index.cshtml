@using NoteKeeperPro.Application.Dtos.Notes
@model IEnumerable<NoteToReturnDto>

@{
    ViewData["Title"] = "Notes";
    var message = TempData["Message"] as string;
}

<form asp-controller="Note" asp-action="Index" method="get" class="mb-3 row">
    <div class="col-md-8">
        <input type="text" name="searchTerm" class="form-control" placeholder="Search notes by title or tag..." />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-controller="Note" asp-action="Index" class="btn btn-outline-secondary ms-2">Reset</a>
    </div>
</form>


@if (!string.IsNullOrEmpty(message))
{
    <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <img src="..." class="rounded mr-2" alt="...">
            <strong class="mr-auto">Bootstrap</strong>
            <small>Just now</small>
            <button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="toast-body">
            @message
        </div>
    </div>
}

<h1>All Notes</h1>
<br />
<a class="btn btn-primary" asp-controller="Note" asp-action="Create">Create Note</a>
<br />
<br />

@if (Model.Any())
{
    <table class="table table-striped table-hover mt-3">
        <thead class="text-center">
            <tr>
                <th>Title</th>
                <th>Content</th>
                <th>Collaborators</th>
                <th>Tags</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach (var note in Model)
            {
                <tr>
                    <td>@note.Title</td>
                    <td>@note.Content</td>
                    <td>
                        @foreach (var collab in note.Collaborators)
                        {
                            <span class="badge bg-info">@collab.UserName</span>
                        }
                    </td>
                    <td>
                        @foreach (var tag in note.Tags)
                        {
                            <span class="badge bg-secondary">@tag.Name</span>
                        }
                    </td>
                    <partial name="_ButtonsPartial" model="@note.Id" />
                </tr>

                <!-- Modal for Deletion -->
                <div class="modal fade" id="deleteModal-@note.Id" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel-@note.Id" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="deleteModalLabel-@note.Id">Delete Note</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete <strong>@note.Title</strong>?
                            </div>
                            <div class="modal-footer">
                                <form asp-action="Delete" asp-controller="Note" asp-route-id="@note.Id" method="post">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <input type="submit" value="Delete" class="btn btn-danger" />
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-3">
        <h4>No Notes Found</h4>
    </div>
}
